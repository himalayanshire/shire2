# The site is fully static — no database or admin panel is needed to run it.
# Nothing below is required to build or serve the pages.

# Inquiry form email delivery (used by /api/inquiries).
# Option A: Gmail SMTP (app password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Option B: Resend
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="The Himalayan Shire <onboarding@resend.dev>"

# Optional analytics overrides (defaults are built in)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Shire chat assistant — works with no key (free public endpoints).
# Optional, for steadier answers: free key from console.groq.com
GROQ_API_KEY=
# SHIRE_ENABLED=false   # switch the assistant off
